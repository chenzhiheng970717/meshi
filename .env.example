# 复制成 .env 并填入真实值。.env 已在 .gitignore 里，不会被提交。
# `npm run dev` / `npm run check:api` / `npm run sample:open` 会自动加载 .env。

# --- HotPepper グルメサーチAPI ---
# 申请：https://webservice.recruit.co.jp/
# 一个 Key 覆盖全部 12 个 API（グルメサーチ / ジャンルマスタ / 予算マスタ 等）。
# 只在 Supabase Edge Function 的环境变量里使用，绝不放进前端代码或提交进仓库。
# 没填时，后端自动回落到演示数据（supabase/functions/_shared/mock/）。
HOTPEPPER_API_KEY=

# --- Supabase ---
# anon key 是公开的，可以放前端；service_role key 绝对不能。
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps Platform（ADR-004 评分 + ADR-007 地理编码）---
# 一个 key 同时用于 Places API (New) 和 Geocoding API。只在 Edge Function 环境变量里用。
# 【硬约束】启用当天就去 Cloud Console → Quotas 设每日请求数上限：
#   Places「每日请求数」→ 200/天，Geocoding → 500/天。
#   预算告警只发邮件不阻断计费，配额上限才是熔断器。
GOOGLE_PLACES_API_KEY=
