# 复制成 .env 并填入真实值。.env 已在 .gitignore 里，不会被提交。

# --- HotPepper グルメサーチAPI ---
# 申请：https://webservice.recruit.co.jp/
# 只在 Supabase Edge Function 的环境变量里使用，绝不放进前端代码。
HOTPEPPER_API_KEY=

# --- Supabase ---
# anon key 是公开的，可以放前端；service_role key 绝对不能。
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Places（v1.1 可选）---
# 启用当天就去 Cloud Console 设每日配额上限（Quotas），不要只设预算告警。
GOOGLE_PLACES_API_KEY=
